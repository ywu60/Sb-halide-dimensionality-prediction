# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets and local configuration
.env
*.env

# Raw/prepared data and trained models
data/
*.xlsx
*.joblib
*.pt
# Publish the two core datasets so the ML/figure pipelines are runnable from a
# fresh clone; anything else generated under data/ stays ignored.
!data/
data/*
!data/merged_compound_cif_cation.xlsx
!data/prepared_data.xlsx
!data/new_mixed_halide_sb_compounds.xlsx
!data/train_test_split.csv

# Generated results
results_ml/
results_llm/
# Publish the reference LLM results Figure 3 is built from, plus the per-call test predictions and
# run logs behind them (llm_outputs/); everything else generated under results_llm/ stays ignored.
!results_llm/
results_llm/*
!results_llm/llm_results.csv
!results_llm/llm_outputs/
results/
results_with_data/
# Publish the reference LLM feature-importance results Figures 4/5 are built from;
# everything else under these two directories (raw responses, generated figures) stays ignored.
!llm_feature_importance/results/
llm_feature_importance/results/*
!llm_feature_importance/results/model_feature_importance.csv
!llm_feature_importance/results/model_stability_kendall.csv
!llm_feature_importance/results/intermodel_kendall.csv
!llm_feature_importance/results/rankings_long.csv
!llm_feature_importance/results/run_manifest.json
!llm_feature_importance/results_with_data/
llm_feature_importance/results_with_data/*
!llm_feature_importance/results_with_data/model_feature_importance.csv
!llm_feature_importance/results_with_data/model_stability_kendall.csv
!llm_feature_importance/results_with_data/intermodel_kendall.csv
!llm_feature_importance/results_with_data/rankings_long.csv
!llm_feature_importance/results_with_data/run_manifest.json
comparison/
figures/
# Keep Figure 2/3/4/5's reproducibility code and reference images while continuing to
# ignore generated figures.
!figures/
figures/*
!figures/figrue_2/
!figures/figrue_2/**
!figures/figure_3/
!figures/figure_3/**
!figures/figure_4/
!figures/figure_4/**
!figures/figure_5/
!figures/figure_5/**
# "!figures/" above re-includes every directory named figures, so re-ignore the figures
# llm_feature_importance.plot generates next to its reference CSVs.
llm_feature_importance/results/figures/
llm_feature_importance/results_with_data/figures/
models_fulldata/
*_checkpoint.csv
raw_llm_responses.jsonl

# Keep the extraction framework's workflow figure and its source generator.
!data_extraction/figures/
!data_extraction/figures/**

# OS/editor files
.DS_Store
.Rhistory
.idea/
.vscode/
